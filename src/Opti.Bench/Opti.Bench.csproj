<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Opti.Bench</AssemblyName>
    <RootNamespace>Opti.Bench</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier Condition="'$(PublishForWindows)' == 'true'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(PublishForWindows)' == 'true'">true</SelfContained>
    <PublishSingleFile Condition="'$(PublishForWindows)' == 'true'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Opti.Core\Opti.Core.csproj" />
    <ProjectReference Include="..\Opti.Measure\Opti.Measure.csproj" />
    <ProjectReference Include="..\Opti.Native\Opti.Native.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.5.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.5.0" />
  </ItemGroup>
</Project>
