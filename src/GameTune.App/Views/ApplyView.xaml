<UserControl x:Class="GameTune.App.Views.ApplyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,28" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Body}" FontSize="16"/>
            <TextBlock Text="{Binding RestorePoint}" Style="{StaticResource MutedText}" Margin="0,4,0,0" Visibility="{Binding RestorePoint, Converter={StaticResource StrToVis}}"/>

            <ItemsControl ItemsSource="{Binding PostRebootItems}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" BorderBrush="{Binding Color}" BorderThickness="3,1,1,1">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Log}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" BorderBrush="{Binding Color}" BorderThickness="3,1,1,1">
                            <Expander>
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Details}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontFamily="Consolas" FontSize="12"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource Accent}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding NextText}" Style="{StaticResource Body}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Перезагрузить сейчас" Command="{Binding RebootNowCommand}"
                                Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource AccentButton}" Content="Дальше: замер" Command="{Binding ContinueCommand}"
                                Visibility="{Binding RebootRequired, Converter={StaticResource InvBoolToVis}}"/>
                        <Button Style="{StaticResource DangerButton}" Content="Откатить изменения" Command="{Binding RollbackCommand}"
                                Visibility="{Binding SuggestRollback, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
