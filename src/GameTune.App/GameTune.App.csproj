<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>GameTune</AssemblyName>
    <RootNamespace>GameTune.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gametune.ico</ApplicationIcon>
    <RuntimeIdentifier Condition="'$(PublishForWindows)' == 'true'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(PublishForWindows)' == 'true'">true</SelfContained>
    <PublishSingleFile Condition="'$(PublishForWindows)' == 'true'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameTune.ViewModels\GameTune.ViewModels.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\gametune.ico" />
    <Resource Include="Assets\gametune.png" />
  </ItemGroup>
</Project>
