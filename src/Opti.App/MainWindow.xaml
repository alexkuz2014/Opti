<Window x:Class="Opti.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Opti.ViewModels;assembly=Opti.ViewModels"
        xmlns:v="clr-namespace:Opti.App.Views"
        Title="Opti" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/opti.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalysisViewModel}"><v:AnalysisView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MeasureViewModel}"><v:MeasureView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StrategyViewModel}"><v:StrategyView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApplyViewModel}"><v:ApplyView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompareViewModel}"><v:CompareView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupViewModel}"><v:CleanupView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Навигация -->
        <DockPanel Margin="0,12,0,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,6,0,22">
                <Image Source="pack://application:,,,/Assets/opti.png" Width="22" Height="22"/>
                <TextBlock Text="Opti" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding WindowTitle}" Style="{StaticResource Caption}" Margin="22,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Nav}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource NavButton}" IsEnabled="{Binding IsEnabled}" CommandParameter="{Binding}"
                                Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-12,0,0,0"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Width="30"/>
                                    <TextBlock x:Name="NavTitle" Text="{Binding Title}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="NavTitle" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- Содержимое -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Margin="24,16,24,0" Padding="14,10" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding UpdateMessage, Converter={StaticResource StrToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Скачать" Command="{Binding OpenUpdateCommand}" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding UpdateMessage}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False"/>
                <Border Grid.Row="2" Margin="24,0,24,16" Padding="14,10" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding Toast, Converter={StaticResource StrToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" Padding="8,6"
                                Command="{Binding CloseToastCommand}" VerticalAlignment="Center"/>
                        <Ellipse Style="{StaticResource Dot}" Fill="{Binding ToastColor, Converter={StaticResource ToneToBrush}}"/>
                        <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
