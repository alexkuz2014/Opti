<UserControl x:Class="Opti.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Left">
            <!-- Фирменный баннер: тёмная поверхность с логотипом в обеих темах -->
            <Border CornerRadius="12" Background="{StaticResource BrandHeroBrush}" ClipToBounds="True">
                <Grid>
                    <Ellipse Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-120,0" IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#5519B4F6" Offset="0"/>
                                <GradientStop Color="#001565FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <DockPanel Margin="28,24,28,26">
                        <Image DockPanel.Dock="Right" Source="pack://application:,,,/Assets/opti.png" Width="112" Height="112" VerticalAlignment="Center"
                               Margin="24,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel>
                            <Image Source="pack://application:,,,/Assets/opti-wordmark.png" Height="54" HorizontalAlignment="Left" Margin="-14,-8,0,6"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Найдём, что тормозит" Style="{StaticResource HeroTitle}"/>
                            <TextBlock Style="{StaticResource HeroText}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,6,0,0"
                                       Text="Opti проверит компьютер, драйверы и реестр, исправит только то, что действительно мешает, и покажет результат честным замером. Любое изменение можно откатить."/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,24,0,0" Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Продолжить" Command="{Binding ContinueSessionCommand}" VerticalAlignment="Center" Margin="0"/>
                    <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Незавершённая сессия" Style="{StaticResource Strong}"/>
                        <TextBlock Text="{Binding OpenSessionText}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Что важнее" Style="{StaticResource SectionTitle}"/>
            <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="150">
                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource AccentButton}" Content="Проанализировать" Padding="24,9" Command="{Binding AnalyzeCommand}"/>
                <Button Content="Отмена" Command="{Binding CancelAnalysisCommand}" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Width="360" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                <TextBlock Text="30–60 секунд, только чтение — ничего не меняется." Style="{StaticResource Caption}"/>
            </StackPanel>

            <TextBlock Text="Ещё" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="Открыть" Command="{Binding OpenCleanupCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        <TextBlock DockPanel.Dock="Top" Text="&#xEA99;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Left" Margin="0,0,0,10"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Бережная очистка" Style="{StaticResource Strong}"/>
                            <TextBlock Text="{Binding DiskText}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="Места мало — очистка может помочь." Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding DiskLow, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="Проверить" Command="{Binding OpenDriversCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        <TextBlock DockPanel.Dock="Top" Text="&#xE950;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Left" Margin="0,0,0,10"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Драйверы" Style="{StaticResource Strong}"/>
                            <TextBlock Text="Видео, сеть, звук, чипсет — со ссылками на официальные сайты." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="Открыть" Command="{Binding OpenSoftwareCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        <TextBlock DockPanel.Dock="Top" Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Left" Margin="0,0,0,10"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Полезные программы" Style="{StaticResource Strong}"/>
                            <TextBlock Text="От WizTree до Discord — только официальные источники." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
