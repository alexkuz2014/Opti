<UserControl x:Class="Opti.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Left">
            <TextBlock Text="Найдём, что тормозит" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Secondary}"
                       Text="Нажмите «Максимум оптимизации» и отойдите: Opti проверит компьютер, исправит, что мешает, обновит драйверы и покажет результат. Исправления и твики откатываются."/>

            <!-- Незавершённая сессия -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Продолжить" Command="{Binding ContinueSessionCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Незавершённая сессия" Style="{StaticResource Strong}"/>
                        <TextBlock Text="{Binding OpenSessionText}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Настройки Opti, которые сбросились -->
            <Border Style="{StaticResource Callout}" Margin="0,20,0,0" Background="{Binding Source=warn, Converter={StaticResource ToneToSoft}}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="{Binding DriftText, Converter={StaticResource StrToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Восстановить" Command="{Binding RestoreDriftCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{Binding Source=warn, Converter={StaticResource ToneToBrush}}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding DriftText}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Главное действие: цель и запуск анализа в одной карточке -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,18,20,20">
                <StackPanel>
                    <TextBlock Text="Режим" Style="{StaticResource Strong}" Margin="0,0,0,10"/>
                    <!-- Три пресета в одну строку равной ширины -->
                    <ListBox Style="{StaticResource ChoiceList}" ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}" Margin="0,0,-8,0"
                             IsEnabled="{Binding IsIdle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Left"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Left" Style="{StaticResource AccentButton}" Content="Максимум оптимизации" Padding="32,11" FontSize="15" Command="{Binding MaximumCommand}"
                                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}"
                                ToolTip="Нажмите и отойдите: проверка, исправления, твики, очистка, драйверы, перезагрузка и повторный тест — всё само. Откатывается кнопкой в «Истории»"/>
                        <Button DockPanel.Dock="Left" Content="Оптимизировать" Padding="20,10" Command="{Binding OptimizeCommand}" Margin="0,0,8,0"
                                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}"
                                ToolTip="Короче: проверка → быстрый тест → безопасные исправления → повторный тест. Без твиков, очистки и драйверов"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Только проверить" Command="{Binding AnalyzeCommand}" VerticalAlignment="Center" Margin="12,0,0,0"
                                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" ToolTip="Найти проблемы и ничего не менять"/>
                        <Button DockPanel.Dock="Left" Content="Отмена" Command="{Binding CancelAnalysisCommand}" Margin="0,0,12,0" VerticalAlignment="Center"
                                Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="«Максимум»: 10–15 минут без вашего участия, компьютер может перезагрузиться сам" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}"/>
                        <!-- Ход анализа: на месте кнопки, с номером шага -->
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="{Binding ProgressMax, Mode=OneWay}"
                                         IsIndeterminate="{Binding ProgressUnknown, Mode=OneWay}" Height="4"/>
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Изменения Opti, которые сейчас действуют -->
            <Button Style="{StaticResource CardButton}" Margin="0,8,0,0" Command="{Binding OpenHistoryCommand}"
                    Visibility="{Binding ActiveChangesText, Converter={StaticResource StrToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveChangesText}" Style="{StaticResource Strong}"/>
                        <TextBlock Text="Посмотреть и откатить можно в «Истории»" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </DockPanel>
            </Button>

            <TextBlock Text="Инструменты" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Columns="2" Margin="0,0,-8,0">
                <Button Style="{StaticResource CardButton}" Command="{Binding OpenCleanupCommand}">
                    <DockPanel>
                        <TextBlock Text="&#xEA99;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Очистка" Style="{StaticResource Strong}"/>
                            <TextBlock Text="{Binding DiskText}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="Места мало — очистка поможет" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding DiskLow, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Command="{Binding OpenDriversCommand}" IsEnabled="{Binding IsIdle}">
                    <DockPanel>
                        <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Драйверы" Style="{StaticResource Strong}"/>
                            <TextBlock Text="Видео, сеть, звук, чипсет — со ссылками на официальные сайты" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Command="{Binding OpenTweaksCommand}">
                    <DockPanel>
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Твики" Style="{StaticResource Strong}"/>
                            <TextBlock Text="Игры, фоновая нагрузка и удобство — каждый включается и выключается" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Command="{Binding OpenSoftwareCommand}">
                    <DockPanel>
                        <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="Полезные программы" Style="{StaticResource Strong}"/>
                            <TextBlock Text="Проверенный софт — только официальные источники" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
