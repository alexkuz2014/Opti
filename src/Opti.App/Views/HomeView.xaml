<UserControl x:Class="Opti.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,28" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Найдём реальные причины лагов" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource MutedText}" FontSize="15" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Сначала диагноз, потом лечение: Opti анализирует компьютер, меняет только то, что действительно мешает, и честно показывает результат по замерам «до» и «после». Любое изменение можно откатить."/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0" BorderBrush="{StaticResource Accent}"
                    Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Продолжить" Command="{Binding ContinueSessionCommand}" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Незавершённая сессия" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OpenSessionText}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="Что для вас важнее?" Style="{StaticResource H2}"/>
            <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Goals}" SelectedItem="{Binding SelectedGoal}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="270">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontSize="18" Foreground="{StaticResource Accent}" Width="28"/>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="28,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource AccentButton}" Content="Проанализировать компьютер" Padding="22,11" FontSize="15" Command="{Binding AnalyzeCommand}"/>
                <Button Content="Отмена" Command="{Binding CancelAnalysisCommand}" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <StackPanel Margin="0,14,0,0" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Width="420" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                <TextBlock Text="Обычно 30–60 секунд. Ничего не меняется — только чтение." Style="{StaticResource MutedText}"/>
            </StackPanel>

            <TextBlock Text="Как это работает" Style="{StaticResource H2}" Margin="0,30,0,8"/>
            <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource Muted}"
                       Text="1. Анализ (30–60 с) → 2. Отчёт о проблемах → 3. Замер «до» → 4. Стратегия с галочками → 5. Применение с точкой восстановления и журналом → 6. Перезагрузка, если нужна (программа продолжит сама) → 7. Замер «после» → 8. Сравнение и вердикт → 9. Сохранить или откатить."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
