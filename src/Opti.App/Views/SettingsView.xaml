<UserControl x:Class="Opti.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,28" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>

            <TextBlock Text="Цель по умолчанию" Style="{StaticResource H2}"/>
            <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Goals}" SelectedItem="{Binding DefaultGoal}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Width="190"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Замеры" Style="{StaticResource H2}"/>
            <WrapPanel>
                <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="Прогонов (1–10)" Style="{StaticResource MutedText}"/>
                    <TextBox Text="{Binding MeasureRuns, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                </StackPanel>
                <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="Длительность, с" Style="{StaticResource MutedText}"/>
                    <TextBox Text="{Binding MeasureDuration, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                </StackPanel>
                <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="Прогрев, с" Style="{StaticResource MutedText}"/>
                    <TextBox Text="{Binding MeasureWarmup, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                </StackPanel>
            </WrapPanel>
            <TextBlock Text="Путь к PresentMon.exe (необязательно)" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
            <TextBox Text="{Binding PresentMonPath, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Папка настроек OBS (если OBS портативный)" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
            <TextBox Text="{Binding ObsConfigDir, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Сервер для теста сети" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
            <TextBox Text="{Binding NetworkTarget, UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left"/>

            <TextBlock Text="Поведение" Style="{StaticResource H2}"/>
            <CheckBox IsChecked="{Binding RollbackWhenNoEffect}" Margin="0,4">
                <TextBlock TextWrapping="Wrap" Text="Предлагать откат, если замер не показал улучшения (иначе — только пометка «не дало эффекта»)"/>
            </CheckBox>
            <CheckBox IsChecked="{Binding CheckForUpdates}" Margin="0,4">
                <TextBlock TextWrapping="Wrap" Text="Проверять новые версии на GitHub (только уведомление, ничего не скачивается)"/>
            </CheckBox>

            <TextBlock Text="Никогда не предлагать эти исправления" Style="{StaticResource H2}"/>
            <ItemsControl ItemsSource="{Binding ExcludedFixes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,3">
                            <TextBlock>
                                <Run Text="{Binding Detail, Mode=OneWay}"/>
                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="11"/>
                            </TextBlock>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource AccentButton}" Content="Сохранить" Command="{Binding SaveCommand}"/>
                <Button Content="Проверить обновления" Command="{Binding CheckUpdatesCommand}"/>
                <Button Content="Папка данных" Command="{Binding OpenDataDirCommand}"/>
                <Button Content="Все версии" Command="{Binding OpenReleasesCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource MutedText}" Margin="0,16,0,0" FontSize="12">
                <Run Text="Версия"/>
                <Run Text="{Binding Version, Mode=OneWay}"/>
                <Run Text="· данные:"/>
                <Run Text="{Binding DataDir, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
