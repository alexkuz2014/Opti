<UserControl x:Class="Opti.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="40,32,40,40" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="Драйверы" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Secondary}" MaxWidth="680" HorizontalAlignment="Left"
                       Text="Видеокарта, сеть, звук, чипсет, Bluetooth и накопители. Opti ничего не скачивает сам — у каждого устройства ссылка на официальный сайт производителя."/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Обновления Windows" Command="{Binding OpenOptionalUpdatesCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AccentButton}" Content="{Binding OemTitle}" Command="{Binding OpenOemCommand}" Margin="0"
                                Visibility="{Binding HasOem, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Strong}"/>
                        <TextBlock Text="{Binding BoardText}" Style="{StaticResource Caption}" Visibility="{Binding BoardText, Converter={StaticResource StrToVis}}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Порядок: сначала чипсет, затем видеокарта, сеть и звук. После установки — перезагрузка и повторный анализ."/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <CheckBox Content="Только требующие внимания" IsChecked="{Binding OnlyAttention}" Margin="0,12,0,0"/>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="16,10">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding LinkTitle}" VerticalAlignment="Center" Margin="16,0,0,0"
                                                        CommandParameter="{Binding Url}" ToolTip="{Binding Url}"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Tone, Converter={StaticResource ToneToBrush}}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}"/>
                                                    <TextBlock Style="{StaticResource Caption}">
                                                        <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"/>
                                                        <Run Text=" · "/><Run Text="{Binding Details, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
