<UserControl x:Class="Opti.App.Views.MaxRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Left">
            <TextBlock Text="Максимум оптимизации" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Secondary}" Text="Идёт без вашего участия. Не закрывайте Opti и не блокируйте экран: после этого шага пойдёт повторный тест, ему нужно открытое окно."/>
            <Border Style="{StaticResource Card}" Margin="0,20,0,8" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Strong}"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Остановить" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Сделано" Style="{StaticResource SectionTitle}" Visibility="{Binding Steps.Count, Converter={StaticResource CountToVis}}"/>
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,6" HorizontalAlignment="Stretch">
                            <Expander.Header>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Color, Converter={StaticResource ToneToBrush}}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}"/>
                                </DockPanel>
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding Details}" Margin="18,4,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,1" TextWrapping="Wrap"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
