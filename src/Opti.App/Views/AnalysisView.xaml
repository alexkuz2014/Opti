<UserControl x:Class="Opti.App.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,28" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding DeviceText}" Style="{StaticResource MutedText}"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" FontSize="15" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,6">
                <Button Style="{StaticResource AccentButton}" Content="Дальше: замер «до»" Command="{Binding MeasureBeforeCommand}"/>
                <Button Content="Без замера → стратегия" Command="{Binding SkipToStrategyCommand}"/>
                <Button Content="Отчёт в HTML" Command="{Binding ExportReportCommand}"/>
            </StackPanel>
            <TextBlock Text="Без замера «до» программа не сможет показать, стало ли лучше." Style="{StaticResource MutedText}" FontSize="12"/>

            <TextBlock Text="Найденные проблемы" Style="{StaticResource H2}"/>
            <ItemsControl ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" BorderBrush="{Binding Color}" BorderThickness="3,1,1,1">
                            <Expander>
                                <Expander.Header>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SeverityText}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding FixHint}" Style="{StaticResource MutedText}" FontSize="12"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}"/>
                                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource MutedText}" FontFamily="Consolas" FontSize="12"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding ManualSteps}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='→ {0}'}" Style="{StaticResource Body}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Links}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LinkButton}" Content="{Binding}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Профиль ПК" Style="{StaticResource H2}"/>
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding ProfileLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Body}" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <StackPanel Visibility="{Binding Errors.Count, Converter={StaticResource CountToVis}}">
                <TextBlock Text="Что не удалось собрать" Style="{StaticResource H2}"/>
                <ItemsControl ItemsSource="{Binding Errors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontSize="12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
