<UserControl x:Class="Opti.App.Views.StutterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Left">
            <TextBlock Text="Фризы" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource Secondary}" MaxWidth="700" HorizontalAlignment="Left"
                       Text="Когда игра или Windows подлагивает, Opti минуту наблюдает за системой и называет причину: драйвер, который надолго занимает процессор, перегруженный диск, нехватку памяти или фоновую программу. Ничего не меняется."/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,8" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="Запустите проверку и играйте или работайте как обычно. Лучше нажать, когда уже подлагивает." Style="{StaticResource Body}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Проверить фризы (1 минута)" Command="{Binding StartCommand}"/>
                        <Button Content="Остановить" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,14,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding Status, Converter={StaticResource StrToVis}}"/>
                    <TextBlock Text="Недоступно на этом компьютере." Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding IsAvailable, Converter={StaticResource InvBoolToVis}}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Margin="0,12,0,0" Visibility="{Binding Summary, Converter={StaticResource StrToVis}}"/>

            <ItemsControl ItemsSource="{Binding Findings}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,0,0,6" HorizontalAlignment="Stretch" IsExpanded="True">
                            <Expander.Header>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="12,0,0,0" Background="{Binding Color, Converter={StaticResource ToneToSoft}}">
                                        <TextBlock Text="{Binding SeverityText}" Style="{StaticResource TagText}" Foreground="{Binding Color, Converter={StaticResource ToneToBrush}}"/>
                                    </Border>
                                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding Color, Converter={StaticResource ToneToBrush}}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}"/>
                                </DockPanel>
                            </Expander.Header>
                            <StackPanel Margin="18,4,0,4">
                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Body}"/>
                                <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Mono}" TextWrapping="Wrap"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding ManualSteps}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,4,0,0"/>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Body}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
