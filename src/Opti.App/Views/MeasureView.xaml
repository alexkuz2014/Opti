<UserControl x:Class="Opti.App.Views.MeasureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Opti.App.Controls">
    <ScrollViewer>
        <StackPanel Margin="32,28" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding Hint}" Style="{StaticResource MutedText}" FontSize="15" MaxWidth="820" HorizontalAlignment="Left"/>

            <TextBlock Text="Режим" Style="{StaticResource H2}"/>
            <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding ModeEditable}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="300" IsEnabled="{Binding Available}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AvailabilityText}" Foreground="{StaticResource Warn}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Режим тот же, что и в предыдущем замере, — иначе сравнение будет нечестным." Style="{StaticResource MutedText}" FontSize="12"
                       Visibility="{Binding ModeLocked, Converter={StaticResource BoolToVis}}"/>

            <WrapPanel Margin="0,8,0,0">
                <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="Прогонов" Style="{StaticResource MutedText}"/>
                    <TextBox Text="{Binding Runs, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                </StackPanel>
                <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="Длительность, с" Style="{StaticResource MutedText}"/>
                    <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                </StackPanel>
                <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="Прогрев, с" Style="{StaticResource MutedText}"/>
                    <TextBox Text="{Binding Warmup, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                </StackPanel>
                <StackPanel Margin="0,0,18,8">
                    <TextBlock Text="Процесс игры (необязательно)" Style="{StaticResource MutedText}"/>
                    <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                </StackPanel>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource AccentButton}" Content="Начать замер" Command="{Binding StartCommand}"/>
                <Button Content="Остановить" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Пропустить замер" Command="{Binding SkipCommand}" Visibility="{Binding CanSkip, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,16,0,10">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LiveFps}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,10,0,10"/>
                    <c:FrameTimeChart Height="200" Primary="{Binding LiveFrameTimes}" PrimaryBrush="{StaticResource Accent}"/>
                    <TextBlock Text="Живой график фреймтайма (последние кадры). Пики вверх — рывки." Style="{StaticResource MutedText}" FontSize="12"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Выполненные прогоны" Style="{StaticResource H2}" Visibility="{Binding Completed.Count, Converter={StaticResource CountToVis}}"/>
            <ItemsControl ItemsSource="{Binding Completed}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" BorderBrush="{Binding Color}" BorderThickness="3,1,1,1" Padding="14,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Удалить" Padding="10,4" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.RemoveRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding Warning}" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                                               Visibility="{Binding Warning, Converter={StaticResource StrToVis}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource AccentButton}" Content="{Binding FinishText}" Command="{Binding FinishCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
