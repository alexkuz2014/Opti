<UserControl x:Class="Opti.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource ActionBar}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource AccentButton}" Content="Включить рекомендуемые" Command="{Binding EnableRecommendedCommand}"/>
                <Button Content="Сохранить набор" Command="{Binding ExportConfigCommand}" Margin="8,0,0,0" ToolTip="Записать список включённых твиков в файл рядом с программой — для переноса на другой ПК"/>
                <Button Content="Загрузить набор" Command="{Binding ImportConfigCommand}" Margin="8,0,0,0" ToolTip="Включить твики из сохранённого файла рядом с программой"/>
                <Button Content="Выключить все" Command="{Binding DisableAllCommand}" Margin="8,0,0,0" ToolTip="Вернуть значения, которые были до Opti"/>
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,16,0"
                           Text="Каждый твик выключается тем же переключателем — вернётся то, что было до Opti."/>
            </DockPanel>
        </Border>
        <ScrollViewer>
            <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Left">
                <TextBlock Text="Твики" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource Secondary}" MaxWidth="680" HorizontalAlignment="Left"
                           Text="Переключатели Windows в одном месте: игры и фон, реклама и приватность, Проводник, панель задач, ввод. Каждый можно выключить — вернётся то, что было до Opti. На FPS большинство не влияет: это про удобство и порядок."/>

                <DockPanel Margin="0,16,0,0" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" MinWidth="320" AutomationProperties.Name="Поиск твика"
                             ToolTip="Поиск по названию и описанию: например, «панель задач» или «реклама»"/>
                </DockPanel>
                <TextBlock Text="Ничего не найдено — попробуйте другое слово." Style="{StaticResource Caption}" Margin="0,12,0,0"
                           Visibility="{Binding NothingFound, Converter={StaticResource BoolToVis}}"/>

                <!-- Что нужно, чтобы изменения вступили в силу -->
                <Border Style="{StaticResource Callout}" Margin="0,16,0,0" Background="{Binding Source=accent, Converter={StaticResource ToneToSoft}}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="{Binding PendingText, Converter={StaticResource StrToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Перезапустить Проводник" Command="{Binding RestartExplorerCommand}" VerticalAlignment="Center"
                                Visibility="{Binding NeedsExplorerRestart, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding PendingText}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,24,0,10">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <TextBlock Text="{Binding Counter}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="12,0,0,3"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" IsEnabled="{Binding IsAvailable}">
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn}" VerticalAlignment="Center"
                                                              Margin="16,0,0,0" AutomationProperties.Name="{Binding Title}"/>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" VerticalAlignment="Center"/>
                                                            <Border Style="{StaticResource Tag}" Margin="10,0,0,0" Background="{Binding Source=good, Converter={StaticResource ToneToSoft}}"
                                                                    Visibility="{Binding Recommended, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="рекомендуем" Style="{StaticResource TagText}" Foreground="{Binding Source=good, Converter={StaticResource ToneToBrush}}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource Tag}" Margin="10,0,0,0" Background="{Binding EvidenceColor, Converter={StaticResource ToneToSoft}}"
                                                                    Visibility="{Binding ShowEvidence, Converter={StaticResource BoolToVis}}" ToolTip="Насколько надёжно известно, что твик помогает">
                                                                <TextBlock Text="{Binding EvidenceText}" Style="{StaticResource TagText}" Foreground="{Binding EvidenceColor, Converter={StaticResource ToneToBrush}}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding ApplyText}" Style="{StaticResource Caption}" FontSize="11.5"/>
                                                            <Button Style="{StaticResource LinkButton}" Content="Источник" FontSize="11.5" Margin="12,0,0,0" CommandParameter="{Binding Link}"
                                                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Visibility="{Binding Link, Converter={StaticResource StrToVis}}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Error}" Style="{StaticResource Caption}" Foreground="{Binding Source=bad, Converter={StaticResource ToneToBrush}}"
                                                                   Margin="0,4,0,0" Visibility="{Binding Error, Converter={StaticResource StrToVis}}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
