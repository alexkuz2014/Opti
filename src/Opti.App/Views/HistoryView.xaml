<UserControl x:Class="Opti.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,28" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}"/>
            <TextBlock Text="Все сессии оптимизации. Любую можно открыть отчётом или откатить." Style="{StaticResource MutedText}"/>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,14">
                <Button Content="Обновить" Command="{Binding RefreshCommand}"/>
                <Button Style="{StaticResource DangerButton}" Content="Полный откат всех изменений" Command="{Binding RollbackAllCommand}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" BorderBrush="{Binding Color}" BorderThickness="3,1,1,1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Отчёт" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Content="Откатить" Style="{StaticResource DangerButton}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.RollbackSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding OutcomeText}" Foreground="{Binding Color}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
