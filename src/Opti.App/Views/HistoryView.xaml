<UserControl x:Class="Opti.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Left">
            <TextBlock Text="История" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Все сессии. Любую можно открыть отчётом или откатить." Style="{StaticResource Secondary}"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,16">
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                <Button Content="Откатить все изменения Opti" Command="{Binding RollbackAllCommand}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Отчёт" Margin="0,0,8,0" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Content="Откатить" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.RollbackSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Color, Converter={StaticResource ToneToBrush}}"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Strong}">
                                        <Run Text="{Binding Title, Mode=OneWay}"/>
                                        <Run Text="·" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        <Run Text="{Binding OutcomeText, Mode=OneWay}" Foreground="{Binding Color, Converter={StaticResource ToneToBrush}}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
